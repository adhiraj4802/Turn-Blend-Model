# Copy to .env in the repository root and fill in. Never commit the filled-in file.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Pipecat on Daily only (python examples/daily_bot.py -t daily)
DAILY_API_KEY=

# LiveKit only (python examples/livekit_agent.py dev)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: any turn-blend setting, as TURN_BLEND_<SETTING>. Run `python configure_demo.py --list` for all 16.
# TURN_BLEND_BLEND_THRESHOLD=0.85
# TURN_BLEND_BLEND_MIN_SILENCE_MS=320
# TURN_BLEND_TIMEOUT_SECS=3.0
# TURN_BLEND_VAD_CONFIDENCE=0.7
